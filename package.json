{
  "name": "async-query",
  "version": "3.0.5",
  "description": "Asynchronous versions of querySelector() and querySelectorAll()",
  "homepage": "https://github.com/Robot-Inventor/async-query#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/async-query/issues"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/async-query.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "version": "npm run build && git add .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint ./src",
    "ci:version": "changeset version && npm run version",
    "ci:publish": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@robot-inventor/oxlint-config": "^0.5.0",
    "@robot-inventor/tsconfig-base": "^7.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.0"
  }
}
