{
  "name": "async-query",
  "version": "3.0.4",
  "description": "Asynchronous versions of querySelector() and querySelectorAll()",
  "publishConfig": {
    "provenance": true
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "version": "npm run build && git add .",
    "format": "prettier --write ./src/**/*.ts",
    "format:check": "prettier --check ./src/**/*.ts",
    "lint": "eslint ./src/**/*.ts",
    "ci:version": "changeset version-script && npm run version",
    "ci:publish": "npm run build && changeset publish-script"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/async-query.git"
  },
  "author": "Robot-Inventor",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/async-query/issues"
  },
  "homepage": "https://github.com/Robot-Inventor/async-query#readme",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@robot-inventor/eslint-config": "^13.0.0",
    "@robot-inventor/tsconfig-base": "^7.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.2.5",
    "typescript": "^6.0.0"
  }
}
